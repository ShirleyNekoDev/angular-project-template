{
  "name": "placeholder-project-name",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test",
    "test:coverage": "ng test -c coverage",
    "test:storybook": "vitest run",
    "test:storybook:coverage": "vitest run --coverage",
    "coverage": "pnpm test:coverage && pnpm test:storybook:coverage",
    "storybook": "ng run placeholder-project-name:storybook",
    "build-storybook": "ng run placeholder-project-name:build-storybook",
    "create-sbom": "pnpm sbom --sbom-format cyclonedx --sbom-type application --out sbom/%s-%v.cdx.json",
    "audit": "pnpm audit"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@angular-devkit/architect": "^0.2202.4",
    "@angular-devkit/core": "^22.2.4",
    "@angular-eslint/builder": "22.6.0",
    "@angular/animations": "22.2.3",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/angular-vite": "^10.6.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "sass-embedded": "1.106.1",
    "storybook": "^10.6.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  }
}
