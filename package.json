{
	"name": "placeholder-project-name",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"lint": "ng lint && stylelint \"src/**/*.{css,scss}\" && markdownlint-cli2",
		"lint:fix": "ng lint --fix && stylelint \"src/**/*.{css,scss}\" --fix && markdownlint-cli2 --fix",
		"lint:dist": "stylelint --config stylelint.dist.config.ts \"dist/**/*.css\"",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "ng test",
		"test:coverage": "ng test -c coverage",
		"test:storybook": "vitest run",
		"test:storybook:coverage": "vitest run --coverage",
		"coverage": "pnpm test:coverage && pnpm test:storybook:coverage",
		"storybook": "ng run placeholder-project-name:storybook",
		"build-storybook": "ng run placeholder-project-name:build-storybook",
		"create-sbom": "pnpm sbom --sbom-format cyclonedx --sbom-type application --out sbom/%s-%v.cdx.json",
		"audit": "pnpm audit"
	},
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"type": "module",
	"dependencies": {
		"@angular/cdk": "22.3.0",
		"@angular/common": "22.2.6",
		"@angular/compiler": "22.2.6",
		"@angular/core": "22.2.6",
		"@angular/forms": "22.2.6",
		"@angular/platform-browser": "22.2.6",
		"@angular/router": "22.2.6",
		"rxjs": "7.8.2",
		"temporal-polyfill": "1.0.8",
		"tslib": "2.9.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "2.9.7",
		"@angular-devkit/architect": "0.2202.7",
		"@angular-devkit/core": "22.2.7",
		"@angular-eslint/builder": "22.8.0",
		"@angular/animations": "22.2.6",
		"@angular/build": "22.2.7",
		"@angular/cli": "22.2.7",
		"@angular/compiler-cli": "22.2.6",
		"@eslint/js": "10.0.1",
		"@storybook/addon-vitest": "10.6.7",
		"@storybook/angular-vite": "10.6.7",
		"@vitest/browser": "5.1.1",
		"@vitest/browser-playwright": "5.1.1",
		"@vitest/coverage-v8": "5.1.1",
		"angular-eslint": "22.8.0",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-node": "^0.4.0",
		"eslint-plugin-compat": "7.0.2",
		"eslint-plugin-import-x": "4.18.1",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-storybook": "10.6.7",
		"happy-dom": "^21.0.4",
		"markdownlint-cli2": "^0.24.1",
		"playwright": "1.65.1",
		"prettier": "3.10.1",
		"sass-embedded": "1.108.2",
		"storybook": "10.6.7",
		"stylelint": "18.0.0",
		"stylelint-config-standard-scss": "18.0.0",
		"stylelint-no-unsupported-browser-features": "^8.1.2",
		"stylelint-order": "^8.1.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.1"
	}
}
