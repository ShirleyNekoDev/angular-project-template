{
	"compileOnSave": false,
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,

		"target": "ES2025",
		"lib": ["es2025", "esnext.temporal", "esnext.iterator", "dom", "dom.iterable", "dom.asynciterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"useDefineForClassFields": true,

		"importHelpers": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": true,
		"strictInputAccessModifiers": true,
		"strictTemplates": true,
		"extendedDiagnostics": {
			"checks": {
				"invalidBananaInBox": "error",
				"nullishCoalescingNotNullable": "error",
				"optionalChainNotNullable": "error",
				"uninvokedFunctionInEventBinding": "error",
				"interpolatedSignalNotInvoked": "error",
				"uninvokedFunctionInTextInterpolation": "error",
				"uninvokedTrackFunction": "error",
				"deferTriggerMisconfiguration": "error",
				"skipHydrationNotStatic": "error",
				"unparenthesizedNullishCoalescing": "error",
				"missingControlFlowDirective": "warning",
				"missingStructuralDirective": "warning",
				"textAttributeNotBinding": "warning",
				"missingNgForOfLet": "warning",
				"suffixNotSupported": "warning",
				"controlFlowPreventingContentProjection": "warning",
				"unusedLetDeclaration": "warning",
				"unusedStandaloneImports": "warning"
			}
		}
	},
	"files": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		}
	]
}
